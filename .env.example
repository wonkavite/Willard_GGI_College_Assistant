# Application
ENVIRONMENT=production

# Exact frontend origin(s) allowed by CORS and CSRF validation.
# Use comma-separated origins with scheme and host, without paths.
FRONTEND_ORIGINS=

# Admin authentication
ADMIN_USERNAME=
FIREBASE_ADMIN_EMAIL=
FIREBASE_WEB_API_KEY=

# Firebase service account
GOOGLE_APPLICATION_CREDENTIALS=

# Groq
GROQ_API_KEY=

# Weaviate Cloud
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Weaviate collection
WEAVIATE_COLLECTION_NAME=GGI_Knowledge_Base

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM
GROQ_MODEL=openai/gpt-oss-120b